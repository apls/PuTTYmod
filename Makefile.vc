# Makefile.vc - build putty.exe with Microsoft Visual Studio .NET 2003
#
# Usage (from a "VS .NET 2003 Command Prompt", or after running
# vcvars32.bat):
#
#     nmake -f Makefile.vc          build putty.exe
#     nmake -f Makefile.vc clean    remove build products
#
# Generated by tools/gen_makefile.py; regenerate if source files move.

CC      = cl
RC      = rc
LINK    = link

CFLAGS  = /nologo /TP /MT /O1 /Zc:forScope /W3 /wd4018 /wd4146 /wd4244 /wd4267 /wd4293 /wd4090 /wd4701 /wd4715 /I. /Icompat /Iterminal /Igenerated /Iwindows /DWIN32 /D_WINDOWS /D_CRT_SECURE_NO_WARNINGS /DHAVE_CMAKE_H
BELIST_FLAGS = /DAPPNAME=PuTTY /DSSH=1 /DSERIAL=1 /DOTHERBACKENDS=1

LFLAGS  = /nologo /subsystem:windows /MAP
LIBS    = advapi32.lib comdlg32.lib gdi32.lib imm32.lib ole32.lib shell32.lib user32.lib ws2_32.lib kernel32.lib comctl32.lib

