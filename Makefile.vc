all: putty.exe

putty.exe: $(OBJ) putty.res
	$(LINK) $(LFLAGS) /out:putty.exe $(OBJ) putty.res $(LIBS)

putty.res: windows\putty.rc windows\rcstuff.h windows\putty-rc.h windows\help.rc2 windows\putty-common.rc2 windows\version.rc2 version.h generated\licence.h generated\cmake.h
	$(RC) /fo putty.res /i. /igenerated /d HAVE_CMAKE_H windows\putty.rc

# be_list.c needs the per-application backend-selection defines.
obj\be_list.obj: be_list.c
	$(CC) $(CFLAGS) $(BELIST_FLAGS) /c /Foobj\be_list.obj be_list.c

# generated
{generated\}.c{obj\generated\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\generated\ $<

# utils
{utils\}.c{obj\utils\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\utils\ $<

# stubs
{stubs\}.c{obj\stubs\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\stubs\ $<

# crypto
{crypto\}.c{obj\crypto\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\crypto\ $<

# proxy
{proxy\}.c{obj\proxy\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\proxy\ $<

# ssh
{ssh\}.c{obj\ssh\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\ssh\ $<

# terminal
{terminal\}.c{obj\terminal\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\terminal\ $<

# windows
{windows\}.c{obj\windows\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\windows\ $<

# windows\utils
{windows\utils\}.c{obj\wutils\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\wutils\ $<

# otherbackends
{otherbackends\}.c{obj\otherbackends\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\otherbackends\ $<

# compat
{compat\}.c{obj\compat\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\compat\ $<

# root directory (except be_list.c, which has its own rule above)
{.\}.c{obj\}.obj:
	$(CC) $(CFLAGS) /c /Foobj\ $<

dirs:
	@if not exist obj mkdir obj
	@if not exist obj\generated mkdir obj\generated
	@if not exist obj\utils mkdir obj\utils
	@if not exist obj\stubs mkdir obj\stubs
	@if not exist obj\crypto mkdir obj\crypto
	@if not exist obj\proxy mkdir obj\proxy
	@if not exist obj\ssh mkdir obj\ssh
	@if not exist obj\terminal mkdir obj\terminal
	@if not exist obj\windows mkdir obj\windows
	@if not exist obj\wutils mkdir obj\wutils
	@if not exist obj\otherbackends mkdir obj\otherbackends
	@if not exist obj\compat mkdir obj\compat

clean:
	-@if exist obj rmdir /s /q obj
	-@del /q putty.exe putty.res putty.map 2>nul
